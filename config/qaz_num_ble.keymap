#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    macros {
        Volume_Mute: Volume_Mute {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp C_AC_NEXT_KEYBOARD_LAYOUT_SELECT &kp F1>;
            label = "VOLUME_MUTE";
        };

        Volume_Down: Volume_down {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp C_AC_NEXT_KEYBOARD_LAYOUT_SELECT &kp F2>;
            label = "VOLUME_DOWN";
        };

        Volume_Up: Volume_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp C_AC_NEXT_KEYBOARD_LAYOUT_SELECT &kp F3>;
            label = "VOLUME_UP";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_1 {
            bindings = <
&kp C_MUTE           &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp LG(LS(S))
&trans               &kp N7             &kp N8           &kp N9
&kp RC(RIGHT_SHIFT)  &kp N4             &kp N5           &kp N6
&kp LA(F4)           &kp N1             &kp N2           &kp N3
&kp LG(RS(LEFT))     &trans             &trans           &kp LG(LS(RIGHT))
            >;
        };
    };
};
