#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

// NUMPAD.dtsi 内の qaz_num_ble_numpad_transform ノード

map = <
    /* row-0 */ RC(0,1) RC(0,2) RC(0,3) RC(0,4)
    /* row-1 */ RC(1,0) RC(1,2) RC(1,3) RC(1,4)
    /* row-2 */ RC(2,0) RC(2,1) RC(2,3) RC(2,4) // RC(2,4)を追加
    /* row-3 */ RC(3,0) RC(3,1) RC(3,2) RC(3,4)
    /* row-4 */ RC(4,0) RC(4,1) RC(4,2) RC(4,3) // RC(4,1)とRC(4,3)を追加
>;

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Numpad";
            bindings = <
&kp BACKSPACE  &kp KP_DIVIDE   &kp KP_MULTIPLY  &kp KP_MINUS
&kp KP_N7      &kp KP_N8       &kp KP_N9        &kp KP_PLUS
&kp KP_N4      &kp KP_N5       &kp KP_N6        &none
&kp KP_N1      &kp KP_N2       &kp KP_N3        &kp KP_ENTER
               &lt 1 NUMBER_0  &none            &kp KP_DOT
            >;
        };

        layer_2 {
            display-name = "Layer2";
            bindings = <
&bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3
&bt BT_CLR_ALL  &trans        &trans        &trans
&trans          &trans        &trans        &trans
&trans          &trans        &trans        &trans
                &trans        &trans        &trans
            >;
        };

        layer_3 {
            display-name = "Layer3";
            bindings = <
&trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans
        &trans  &trans  &trans
            >;
        };

        layer_4 {
            display-name = "Layer4";
            bindings = <
&trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans
        &trans  &trans  &trans
            >;
        };

        layer_5 {
            display-name = "Layer5";
            bindings = <
&trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans
        &trans  &trans  &trans
            >;
        };
    };
};
